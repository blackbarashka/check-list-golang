FROM golang:alpine AS builder
WORKDIR /app

# Добавляем установку git
RUN apk add --no-cache git

COPY go.mod go.sum* ./
ENV GOPROXY=direct
RUN go mod download

COPY . .
RUN go build -o worker-app ./worker/main.go

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/worker-app .

CMD ["./worker-app"]